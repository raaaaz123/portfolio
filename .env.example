# Copy to .env and fill in. Everything prefixed VITE_ is bundled into the
# client build and is therefore publicly visible — never put a secret here.

# PostHog analytics
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=

# The hire-me form needs no configuration: it composes the enquiry in the
# browser and hands it to the visitor's email or WhatsApp. Address and phone
# come from src/data/personalInfo.ts.

# Ask AI chat — server-only. Read by api/chat.ts (Vercel) and the Vite dev
# server. NEVER prefix these with VITE_, or the key ships to every visitor.
BEDROCK_API_KEY=
BEDROCK_REGION=us-east-1
BEDROCK_MODEL=moonshotai.kimi-k2.5
